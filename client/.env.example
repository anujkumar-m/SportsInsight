# Client environment variables — example/template
# Copy to .env (development) or .env.production (production) and fill in values

# Backend API URL
# Development: http://localhost:5000
# Production:  https://your-app.onrender.com  (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# Admin emails (comma-separated) shown on the PendingRole page
VITE_ADMIN_EMAIL=admin@example.com
