# Standalone Athlete Eligibility Simulator - Environment Configuration
# The simulator automatically locates and loads the existing server/.env file.
# If you wish to override settings specifically for the simulator, you can create
# an .env file here in the ml/ folder or point ML_ENV_FILE to your custom path.

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sports_academy
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: Path to custom .env file
# ML_ENV_FILE=../server/.env
